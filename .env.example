# Copy to .env and fill in keys to enable LIVE existence checks.
# Without keys, UPI Guard still uses format / provider / fraud rules.

# --- Razorpay VPA validation (recommended for UPI existence) ---
# Create keys at https://dashboard.razorpay.com/app/keys
# Docs: https://razorpay.com/docs/payments/payment-methods/upi/vpa-validation/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Cashfree UPI verification (alternative) ---
# https://www.cashfree.com/docs/api-reference/vrs/v2/upi-verification/upi-verification
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox

# --- Optional mobile line lookup (Numverify / apilayer) ---
NUMVERIFY_ACCESS_KEY=

# Flask session secret
UPI_GUARD_SECRET=change-me-in-production
